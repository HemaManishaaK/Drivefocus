# Copy this file to .env and fill in your real key:
#   cp .env.example .env
#
# Only required for LIVE mode (python main.py, without --dry-run).
# Not needed for --dry-run or for `pytest test_acceptance.py`, both of
# which use simulated_rime.py instead.

RIME_API_KEY=your_rime_api_key_here

# Optional overrides (defaults live in main.py / rime_client.py):
# RIME_SPEAKER=astra
# RIME_MODEL_ID=mistv2
